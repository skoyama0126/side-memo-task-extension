{
  "manifest_version": 3,
  "name": "Side Memo Task Extension",
  "description": "Side panel note, snippets, and todo manager for personal Chrome use.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Side Memo"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
